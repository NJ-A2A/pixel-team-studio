    "new": {
      "whiteboard": "whiteboard(x,y,w): whiteboard with a parameterized number of sticky notes",
      "videowall": "videowall(x,y,w): monitoring display with a four-panel chart",
      "headsetdesk": "headsetdesk(x,y): support desk with a hanging headset",
      "micbooth": "micbooth(x,y): acoustic recording hood with a suspended microphone",
      "assetshelf": "assetshelf(x,y,h): asset shelf filled with icons",
      "sink": "sink(x,y): data-cleaning sink with a dripping animation",
      "blackboard": "blackboard(x,y,w): formula blackboard",
      "paperstack": "paperstack(x,y): manuscript stack with a red pen",
      "antenna": "antenna(x,y): collection antenna with blinking signal dots",
      "langboard": "langboard(x,y,w): Chinese, Korean, and English caption display"
    },
    "palette": "Reuse the bird-character palette; new furniture introduces no additional colors."
  },

