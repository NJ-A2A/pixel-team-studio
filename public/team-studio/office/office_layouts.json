{
  "schema": "office-layout/1",
  "note": "All coordinates are relative to their grid cell, not the canvas. The generator converts cell + margin into canvas coordinates before writing office.json. Moving a zone changes its cell, never its furniture coordinates.",

  "grid": {
    "cell": [208, 144],
    "margin": 8,
    "display_scale": 2,
    "canvas_formula": "[cols*208+16, rows*144+16]",
    "verified": {
      "2x2": [432, 304],
      "3x2": [640, 304],
      "3x3": [640, 448],
      "4x3": [848, 448]
    },
    "rule": "Furniture must stay fully inside its cell with a 4px safe edge. Each zone can then be exported as an independent 208x144 slice and composed by the frontend without rerunning Python for custom layouts."
  },

  "state_runtime": {
    "applies_to": "layout.model == 'state'",
    "position_semantics": "settled zone is data; movement is only a short-lived transition signal",
    "tick": {
      "strategy": "diff",
      "identity": "actor_instance_id",
      "compare": ["zoneId", "task.status", "task.progress", "flowRevision"],
      "unchanged": "keep settled position; do not start any locomotion animation",
      "changed_zone": "emit exactly one transit event"
    },
    "transition": {
      "phases": ["settled", "transit", "settled"],
      "route": ["exit_door", "corridor_lane", "entry_door"],
      "pathfinding": false,
      "forward_duration_ms": 2200,
      "rollback_duration_ms": 3200,
      "animation_fill_mode": "both",
      "loop": false
    },
    "accounting": {
      "transit": "exclude",
      "busy": "unchanged while transit",
      "slack": "unchanged while transit",
      "resume_scoring": "after transitionend and settled commit"
    },
    "blocked": {
      "movement": "none",
      "position": "next zone entry_door minus 8px along incoming axis",
      "facing": "next zone",
      "pose": "sit",
      "bubble": "BLOCK",
      "allowed_motion": "two-frame foot tap without translation"
    },
    "rollback": {
      "detect": "next flow index < previous flow index",
      "speed": "0.7x forward speed",
      "marker": "red back arrow",
      "facing": "toward previous stage",
      "metric": "rework transit; excluded from busy and slack"
    },
    "anchors": {
      "units": "cell-relative pixels",
      "cell_size": [208, 144],
      "sprint6": {
        "flow": ["todo", "doing", "review", "done"],
        "zones": {
          "todo": { "settled": [86, 118], "entry_door": [4, 112], "exit_door": [204, 112] },
          "doing": { "settled": [78, 104], "entry_door": [4, 112], "exit_door": [204, 112] },
          "review": { "settled": [96, 114], "entry_door": [4, 112], "exit_door": [104, 140] },
          "done": { "settled": [92, 118], "entry_door": [104, 4], "exit_door": [204, 112] },
          "standup": { "settled": [104, 100], "entry_door": [104, 4], "exit_door": [104, 140] },
          "sleep": { "settled": [44, 44], "entry_door": [104, 4], "exit_door": [104, 140] }
        }
      },
      "lab6": {
        "flow": ["collect", "clean", "model", "viz"],
        "zones": {
          "collect": { "settled": [98, 116], "entry_door": [4, 112], "exit_door": [204, 112] },
          "clean": { "settled": [98, 120], "entry_door": [4, 112], "exit_door": [204, 112] },
          "model": { "settled": [62, 116], "entry_door": [4, 112], "exit_door": [104, 140] },
          "viz": { "settled": [86, 116], "entry_door": [104, 4], "exit_door": [204, 112] },
          "seminar": { "settled": [104, 100], "entry_door": [104, 4], "exit_door": [104, 140] },
          "sleep": { "settled": [44, 44], "entry_door": [104, 4], "exit_door": [104, 140] }
        }
      }
    }
  },

  "furniture": {
    "reuse": {
      "desk": "desk(x,y,w)",
      "chair": "chair(x,y,dir)",
      "arcade": "arcade(x,y)",
      "bed": "bed(x,y)",
      "nightlight": "nightlight(x,y)",
      "corkboard": "corkboard(x,y,w)",
      "easel": "easel(x,y)",
      "swatchwall": "swatchwall(x,y,w)",
      "rack": "rack(x,y)",
      "barchart": "barchart(x,y,w)",
      "bugjar": "bugjar(x,y)",
      "checklist": "checklist(x,y)",
      "conveyor": "conveyor(x,y,w)",
      "box": "box(x,y)",
      "calendarwall": "calendarwall(x,y,w)",
      "mug": "mug(x,y)",
      "sofa": "sofa(x,y,w)",
      "coffeemachine": "coffeemachine(x,y)",
      "plant": "plant(x,y)"
